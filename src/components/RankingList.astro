---
import { models } from '../data/models';
import { categories, metricLabels, type Metric } from '../data/config';
import { rankModels } from '../lib/decision';
import { ModelMark } from './ModelCard';
import { Plus } from 'lucide-react';
import IntelligenceRanking from './IntelligenceRanking';
import SpeedRanking from './SpeedRanking';
import MetricRanking from './MetricRanking';
import {
  getScoreRankingMetric,
  rankIntelligenceModels,
  rankLowestCostModels,
  rankScoreModels,
  rankSpeedModels,
} from '../lib/rankings';
interface Props {
  metric?: Metric;
  slug?: string;
}
const { slug = 'overall' } = Astro.props;
const baseModels = models;
const rankingAsOf = new Date().toISOString().slice(0, 10);
const scoreMetric = getScoreRankingMetric(slug);
const intelligenceItems =
  slug === 'intelligence'
    ? rankIntelligenceModels(models, rankingAsOf).map((result) => ({
        slug: result.model.slug,
        name: result.model.name,
        provider: result.model.provider,
        family: result.model.family,
        description: result.model.description,
        tags: result.model.tags,
        weakness: result.model.weaknesses[0],
        rank: result.rank,
        score: result.score,
        rawScore: result.rawScore,
        confidence: result.model.confidence,
        lastVerifiedAt: result.model.lastVerifiedAt ?? '',
        components: result.components,
      }))
    : [];
const speedItems =
  slug === 'speed'
    ? rankSpeedModels(models, rankingAsOf).map((result) => ({
        slug: result.model.slug,
        name: result.model.name,
        provider: result.model.provider,
        family: result.model.family,
        description: result.model.description,
        tags: result.model.tags,
        weakness: result.model.weaknesses[0],
        rank: result.rank,
        speedTokensPerSec: result.speedTokensPerSec,
        range: result.measurement.range,
        confidence: result.model.confidence,
        speedVerifiedAt: result.measurement.verifiedAt,
      }))
    : [];
const scoreItems = scoreMetric
  ? rankScoreModels(models, scoreMetric, rankingAsOf).map((result) => ({
      slug: result.model.slug,
      name: result.model.name,
      provider: result.model.provider,
      family: result.model.family,
      description: result.model.description,
      tags: result.model.tags,
      weakness: result.model.weaknesses[0],
      rank: result.rank,
      value: result.score,
      tieScore: result.model.confidence,
      verifiedAt: result.model.lastVerifiedAt ?? '',
    }))
  : [];
const costItems =
  slug === 'cheap'
    ? rankLowestCostModels(models, rankingAsOf).map((result) => ({
        slug: result.model.slug,
        name: result.model.name,
        provider: result.model.provider,
        family: result.model.family,
        description: result.model.description,
        tags: result.model.tags,
        weakness: result.model.weaknesses[0],
        rank: result.rank,
        value: result.inputPrice,
        tieScore: result.model.scores.costEfficiency ?? -1,
        verifiedAt: result.priceVerifiedAt,
      }))
    : [];
const ranked = rankModels(baseModels, 'overall');
---

<nav class="ranking-tabs" aria-label="Ranking categories">
  <a href="/rankings" aria-current={slug === 'overall' ? 'page' : undefined}
    >Overall</a
  >{
    categories.map((c) => (
      <a
        href={`/rankings/${c.slug}`}
        aria-current={slug === c.slug ? 'page' : undefined}
      >
        {c.label}
      </a>
    ))
  }
</nav>
<div class="notice">
  {
    slug === 'intelligence'
      ? 'Current production models verified within 90 days. Intelligence fit combines 80% intelligence, 10% coding, and 10% research.'
      : slug === 'speed'
        ? 'Current production models with speed data verified within 90 days. Ranges rank by their highest measured value; single measurements use their only value.'
        : slug === 'cheap'
          ? 'Current production models with current verified standard input pricing. Tiered and unavailable rates are excluded.'
          : scoreMetric === 'costEfficiency'
            ? 'Current production models ranked by capability-adjusted value (effective performance per dollar across standard workload profiles).'
            : scoreMetric
              ? `Current production models verified within 90 days and ranked by evidence-backed ${metricLabels[scoreMetric].toLowerCase()} score.`
              : 'Sample ranking, not a market recommendation. Sorted by overall score, with alphabetical ordering for ties.'
  }
  <a href="/methodology">How scoring works</a>.
</div>
<h2 class="sr-only">Model rankings</h2>
{
  slug === 'intelligence' ? (
    <IntelligenceRanking items={intelligenceItems} client:load />
  ) : slug === 'speed' ? (
    <SpeedRanking items={speedItems} client:load />
  ) : slug === 'cheap' ? (
    <MetricRanking
      items={costItems}
      metricLabel="Lowest cost"
      metricAnchor="pricing"
      valueKind="price"
      defaultDirection="asc"
      client:load
    />
  ) : scoreMetric ? (
    <MetricRanking
      items={scoreItems}
      metricLabel={
        slug === 'value'
          ? 'Capability-adjusted value'
          : metricLabels[scoreMetric]
      }
      metricAnchor={`score-${scoreMetric}`}
      valueKind="score"
      defaultDirection="desc"
      client:load
    />
  ) : (
    <>
      <div class="ranking-controls">
        <div class="ranking-controls-meta">
          <span class="ranking-count-badge">
            <span class="ranking-count-dot" aria-hidden="true" />
            {ranked.length} verified models
          </span>
        </div>
      </div>
      <div class="ranking-list">
        {ranked.map((model, index) => (
          <article class="panel ranking-row">
            <div class="ranking-row-header">
              <div class="ranking-identity">
                <span class="rank-position">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <ModelMark model={model} />
                <h3>
                  <a href={`/models/${model.slug}`}>{model.name}</a>
                </h3>
              </div>
              <a
                class="score-number"
                href={`/models/${model.slug}#score-overall`}
              >
                {model.scores.overall}
                <small>
                  {model.benchmarks?.livebench?.overall != null
                    ? metricLabels.livebenchOverall
                    : metricLabels.overall}{' '}
                  / 100
                </small>
              </a>
            </div>
            <div class="ranking-row-content">
              <p>
                {model.description} Choose it for{' '}
                {model.tags.slice(0, 2).join(' and ').toLowerCase()} in this
                sample.
              </p>
              <div class="rank-notes">
                <div class="rank-notes-meta">
                  <span>Tradeoff: {model.weaknesses[0].toLowerCase()}</span>
                </div>
                <a
                  class="rank-compare-btn"
                  href={`/compare?models=${model.slug}`}
                >
                  <Plus size={12} strokeWidth={2.5} aria-hidden="true" />
                  Add to comparison
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </>
  )
}
