---
import { getProviderLogoInfo } from './ProviderLogo';

export interface Props {
  provider: string;
  size?: number;
  class?: string;
}

const { provider = '', size = 18, class: className = '' } = Astro.props;
const { src, alt, invertOnLight } = getProviderLogoInfo(provider);
---

<img
  src={src}
  alt={alt}
  width={size}
  height={size}
  style={`width: ${size}px; height: ${size}px; aspect-ratio: 1 / 1;`}
  class={`provider-logo-img ${invertOnLight ? 'provider-logo-invert-light' : ''} ${className}`.trim()}
  loading="lazy"
  decoding="async"
/>
