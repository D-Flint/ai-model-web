---
import RootLayout from '../../layouts/RootLayout.astro';
import ComparisonBuilder from '../../components/ComparisonBuilder';
import { models } from '../../data/models';
import { getSeoComparisonPairs } from '../../lib/seoComparisons';
export function getStaticPaths() {
  const pairs = getSeoComparisonPairs(models);
  return pairs.map(({ a, b, slug }) => ({
    params: { pair: slug },
    props: { a, b },
  }));
}
const { a, b } = Astro.props;
---

<RootLayout
  title={`${a.name} vs ${b.name} | Synapse`}
  description={`Compare ${a.name} and ${b.name}: scores, API pricing, capabilities, and tradeoffs.`}
  ><div class="page-heading">
    <div class="breadcrumbs">
      <a href="/compare">Compare</a><span>/</span><span>Head to head</span>
    </div><h1>{a.name} vs {b.name}</h1><p>
      Review the differences, pricing sources, and billing details before you
      decide.
    </p>
  </div><ComparisonBuilder
    models={[a, b]}
    catalogUrl="/catalog.json"
    initial={[a.slug, b.slug]}
    client:load
  /></RootLayout
>
