---
import RootLayout from '../../layouts/RootLayout.astro';
import ComparisonBuilder from '../../components/ComparisonBuilder';
import { env } from 'cloudflare:workers';
import { comparisonSlugs } from '../../lib/comparisonCatalog';
import { resolveComparisonPair } from '../../lib/comparisonPairs';
import { loadComparisonModels } from '../../lib/loadComparisonModels';
import { publishedModels } from '../../data/models';
import { reviewedCatalogPricing } from '../../lib/apiPricing';
import type { CatalogModel } from '../../lib/catalogSchema';
export const prerender = false;

const publishedComparisonSlugs = new Set(
  [...comparisonSlugs].filter((slug) =>
    publishedModels.some((model) => model.slug === slug),
  ),
);

function resolveModel(slug: string): CatalogModel | undefined {
  const found = publishedModels.find((model) => model.slug === slug);
  if (!found) return undefined;
  if (!found.apiPricing) {
    const reviewed = reviewedCatalogPricing(found);
    if (reviewed) return { ...found, apiPricing: reviewed };
  }
  return found;
}

const pair = resolveComparisonPair(Astro.params.pair, publishedComparisonSlugs);
if (!pair) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (
  Astro.params.pair !== pair.canonical ||
  Astro.url.pathname.endsWith('/')
) {
  return Astro.redirect(`/compare/${pair.canonical}${Astro.url.search}`, 301);
}
let records;
try {
  if (pair) {
    if (env?.ASSETS) {
      records = await loadComparisonModels(env.ASSETS, Astro.url, [
        pair.a,
        pair.b,
      ]);
    } else {
      const a = resolveModel(pair.a);
      const b = resolveModel(pair.b);
      if (a && b) records = [a, b];
    }
  }
} catch {
  const a = resolveModel(pair?.a ?? '');
  const b = resolveModel(pair?.b ?? '');
  if (a && b) {
    records = [a, b];
  } else {
    Astro.response.status = 503;
    Astro.response.headers.set('Cache-Control', 'no-store');
    Astro.response.headers.set('Retry-After', '60');
  }
}
const [a, b] = records ?? [];
---

{
  a && b ? (
    <RootLayout
      title={`${a.name} vs ${b.name} | Synapse`}
      description={`Compare ${a.name} and ${b.name}: scores, API pricing, capabilities, and tradeoffs.`}
    >
      <>
        <div class="page-heading">
          <>
            <div class="breadcrumbs">
              <>
                <a href="/compare">Compare</a>
                <span>/</span>
                <span>Head to head</span>
              </>
            </div>
            <h1>
              {a.name} vs {b.name}
            </h1>
            <p>
              Review the differences, pricing sources, and billing details
              before you decide.
            </p>
            <p>
              <a href="/methodology">Scoring methodology and source policy</a>
            </p>
          </>
        </div>
        <ComparisonBuilder
          models={[a, b]}
          catalogUrl="/catalog.json"
          initial={[a.slug, b.slug]}
          client:load
        />
      </>
    </RootLayout>
  ) : (
    <RootLayout
      title={
        pair
          ? 'Comparison unavailable | Synapse'
          : 'Comparison not found | Synapse'
      }
    >
      <div class="page-heading">
        <h1>
          {pair
            ? 'Comparison temporarily unavailable.'
            : 'Comparison not found.'}
        </h1>
        <p>
          {pair
            ? 'The model records could not load. Please try again shortly.'
            : 'Choose two different models from the catalog to create a valid comparison.'}
        </p>
      </div>
      <a class="button primary" href="/compare">
        Open comparison tool
      </a>
    </RootLayout>
  )
}
