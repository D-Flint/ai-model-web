---
import RootLayout from '../layouts/RootLayout.astro';
---

<RootLayout title="Page not found | Synapse"
  ><div class="page-heading">
    <span class="eyebrow">PAGE NOT FOUND</span><h1>
      This path doesn’t lead to a model.
    </h1><p>The page may have moved, or the address may be incomplete.</p>
  </div><a class="button primary" href="/models">Explore models</a><script
    is:inline
  >
    (function () {
      const match = window.location.pathname.match(
        /^\/compare\/([^/]+)-vs-([^/]+)\/?$/,
      );
      if (match) {
        const a = encodeURIComponent(match[1]);
        const b = encodeURIComponent(match[2]);
        window.location.replace(`/compare?models=${a},${b}`);
      }
    })();
  </script></RootLayout
>
