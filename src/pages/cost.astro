---
import RootLayout from '../layouts/RootLayout.astro';
import CostCalculator from '../components/CostCalculator';
import { models } from '../data/models';
---

<RootLayout title="AI model cost calculator | Synapse"
  ><div class="page-heading">
    <span class="eyebrow">MAKE THE NUMBERS MAKE SENSE</span><h1>
      Calculate your API workload
    </h1><p>
      Enter your token counts and number of requests. Every estimate is based on
      your inputs.
    </p>
  </div><CostCalculator models={models} client:load /></RootLayout
>
