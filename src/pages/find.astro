---
import RootLayout from '../layouts/RootLayout.astro';
import ModelFinder from '../components/ModelFinder';
import { publishedModels } from '../data/models';
---

<RootLayout title="Find the right AI model for your work | Synapse"
  ><div class="page-heading">
    <h1>Find a model that fits your work.</h1><p>
      Combine what you do, what matters, and what you require. Synapse checks
      the evidence before it builds your shortlist.
    </p>
  </div><ModelFinder models={publishedModels} client:load /></RootLayout
>
