---
import RootLayout from '../../layouts/RootLayout.astro';
import ApiPricing from '../../components/ApiPricing';
import { rateLabel, compareApiPrice } from '../../lib/apiPricing';
import ModelCard from '../../components/ModelCard';
import ProviderLogo from '../../components/ProviderLogo.astro';
import ModelEffortExplorer from '../../components/ModelEffortExplorer';
import { models } from '../../data/models';
import { metricLabels, overallWeights, type Metric } from '../../data/config';
import { getPublishedRankingModels } from '../../lib/rankings';
import {
  contextSize,
  rankModels,
  getSpeedDisplayValue,
  getSpeedTokensPerSec,
} from '../../lib/decision';
import { ArrowRight, ChevronDown } from 'lucide-react';
export function getStaticPaths() {
  const rankingAsOf = new Date().toISOString().slice(0, 10);
  const rankingModels = getPublishedRankingModels(models, rankingAsOf);
  const publishedModels = [
    ...new Map(
      [...models, ...rankingModels].map((model) => [model.slug, model]),
    ).values(),
  ];

  return publishedModels.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}
const { model } = Astro.props;
const speedTps = getSpeedTokensPerSec(model);
const speedRange = model.facts.speedTokensPerSecRange;
const hasOpenRouterSpeed = speedRange?.sourceId === 'openrouter-throughput';
const speedRating = hasOpenRouterSpeed ? model.scores.speed : null;
const speedDisplayValue = getSpeedDisplayValue(model);
const speedLabel = speedDisplayValue ? `${speedDisplayValue} tokens/sec` : '—';
const alternatives = [
  ...new Map(
    [
      [...models].filter((m) => m.slug !== model.slug).sort(compareApiPrice)[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'speed',
      )[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'overall',
      )[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'dailyUse',
      )[0],
    ].map((m) => [m.slug, m]),
  ).values(),
];
const orderedMetrics: Metric[] = [
  'intelligence',
  'speed',
  'overall',
  'coding',
  'agentic',
  'dailyUse',
  'research',
  'writing',
  'vision',
  'reliability',
  'costEfficiency',
];
---

<RootLayout
  title={`${model.name} — AI Model Score, Pricing, and Review | Synapse`}
  description={model.description}
>
  <div class="page-heading detail-header">
    <div class="breadcrumbs">
      <a href="/models">Models</a><span>/</span><span>{model.name}</span>
    </div>
    <div class="model-detail-hero">
      <div class="detail-hero-left">
        <div class="detail-provider">
          <ProviderLogo provider={model.provider} size={26} />
          <span>{model.provider}</span>
          {
            model.facts.reasoningEffort &&
              model.facts.reasoningEffort.length > 0 &&
              model.facts.reasoningEffort.some(
                (effort) => effort !== 'none',
              ) && (
                <span
                  class={`effort-badge ${model.facts.reasoningEffort.includes('fixed') ? 'effort-fixed' : ''}`}
                  style="margin-left: 6px;"
                  data-effort-badge
                >
                  {model.facts.reasoningEffort.includes('fixed')
                    ? 'Fixed CoT'
                    : `Effort: ${model.facts.defaultEffort !== 'none' ? model.facts.defaultEffort : 'Selectable'}`}
                </span>
              )
          }
        </div>
        <h1>{model.name}</h1><p>{model.description}</p>
        <div class="detail-actions">
          <a class="button primary" href={`/compare?models=${model.slug}`}
            >Add to comparison <ArrowRight size={15} /></a
          >
          {
            model.facts.reasoningEffort &&
              model.facts.reasoningEffort.filter((e) => e !== 'none').length >
                1 && (
                <a
                  class="button"
                  href={`/compare?models=${model.slug}:low,${model.slug}:high`}
                >
                  Compare effort levels
                </a>
              )
          }
          <a class="button" href={`/cost?models=${model.slug}`}
            >Estimate my cost</a
          >
        </div>
      </div><a class="score-number" href="#score-overall"
        ><span data-effort-overall
          >{model.scores.overall !== null ? model.scores.overall : '—'}</span
        ><small>Overall / 100</small></a
      >
    </div>
  </div>
  {
    model.dataKind === 'verified' ? (
      <div class="notice">
        Verified external data tracking {model.sources.length} authoritative
        sources. Last verified: {model.lastVerifiedAt}.
      </div>
    ) : (
      <div class="notice">
        Sample data created September 5, 2026. No real model evaluations or
        provider verification are claimed.
      </div>
    )
  }
  {
    model.facts.reasoningEffort &&
      model.facts.reasoningEffort.filter((e) => e !== 'none').length > 1 && (
        <ModelEffortExplorer model={model} client:load />
      )
  }
  <div class="pillar-summary-bar">
    <div class="pillar-summary-card">
      <span class="pillar-summary-label">Intelligence</span>
      <strong class="pillar-summary-value" data-effort-intelligence
        >{
          model.scores.intelligence !== null ? (
            <>
              {model.scores.intelligence}
              <small>/100</small>
            </>
          ) : (
            '—'
          )
        }</strong
      >
      <span class="micro muted">
        {
          model.scores.intelligence !== null
            ? 'Frontier reasoning & benchmark quality'
            : 'Benchmark pending external evaluation'
        }
      </span>
    </div>
    <div class="pillar-summary-card">
      <span class="pillar-summary-label">Speed</span>
      <strong class="pillar-summary-value" data-effort-speed
        >{speedLabel}</strong
      >
      <span class="micro muted">
        {
          speedTps > 0
            ? `OpenRouter recent throughput · ${speedRating !== null ? `${speedRating}/100 rating` : 'No normalized rating'}`
            : 'Speed measurements not yet claimed'
        }
      </span>
    </div>
    <div class="pillar-summary-card">
      <span class="pillar-summary-label">Price</span>
      <strong class="pillar-summary-value"
        >{rateLabel(model, 'input')}
        <small class="muted">in</small> · {rateLabel(model, 'output')}
        <small class="muted">out</small></strong
      >
      <a class="micro muted" href="#pricing"
        >USD / 1M tokens · sources and freshness</a
      >
    </div>
  </div>
  <div class="detail-grid">
    <section class="panel" id="scores">
      <h2>Capabilities, explained.</h2><p class="micro">
        Select a score to see how it was calculated.
      </p>{
        orderedMetrics.map((metric) => {
          const label = metricLabels[metric];
          const evidence = model.evidence.find((e) => e.metric === metric);
          const sourceObj = model.sources.find(
            (s) => s.id === evidence?.sourceId,
          );
          const scoreVal = model.scores[metric];
          return (
            <details class="score-details" id={`score-${metric}`}>
              <summary>
                <>
                  <span>
                    {label}
                    <ChevronDown size={13} />
                  </span>
                  <strong>
                    <span data-score-value>
                      {scoreVal !== null ? scoreVal : '—'}
                    </span>
                    <small class="micro"> / 100</small>
                  </strong>
                </>
              </summary>
              {scoreVal === null ? (
                <p class="muted">
                  Not enough approved benchmark data currently available for{' '}
                  {label.toLowerCase()} under methodology {model.methodology}.
                </p>
              ) : metric === 'overall' ? (
                <p>
                  Weighted composite of available verified metrics:{' '}
                  {Object.entries(overallWeights)
                    .filter(
                      ([k]) =>
                        model.scores[k as keyof typeof model.scores] !== null,
                    )
                    .map(
                      ([k, w]) =>
                        `${metricLabels[k as Metric]} ${Math.round(w * 100)}%`,
                    )
                    .join(', ')}
                  . Rounded to the nearest integer.
                </p>
              ) : metric === 'speed' ? (
                <p>
                  Measured generation speed:{' '}
                  <strong>{evidence?.raw} tokens/sec</strong>. Normalized
                  rating: {evidence?.normalized} / 100 on a {evidence?.min}–
                  {evidence?.max} tokens/sec scale. Evaluation method:{' '}
                  {evidence?.kind === 'benchmark'
                    ? 'Provider throughput benchmark'
                    : 'Internal evaluation'}
                  .
                </p>
              ) : model.dataKind === 'verified' ? (
                <p>
                  Normalized score: {evidence?.normalized} / 100 derived from
                  raw measurement {evidence?.raw} on a {evidence?.min}–
                  {evidence?.max} scale. Evaluation method:{' '}
                  {evidence?.kind === 'benchmark'
                    ? 'Public benchmark dataset'
                    : 'Internal evaluation'}
                  .
                </p>
              ) : (
                <p>
                  Synthetic fixture input {evidence?.raw} on a {evidence?.min}-
                  {evidence?.max} scale. Normalization: (raw − minimum) /
                  (maximum − minimum) × 100 = {evidence?.normalized}. This input
                  is a test fixture, not a benchmark result.
                </p>
              )}
              <p>
                Methodology: {model.methodology}. Score date:{' '}
                {model.scoreUpdatedAt}. Evidence confidence: {model.confidence}%
                {model.dataKind === 'verified'
                  ? ' (source-backed confidence).'
                  : ' (no real evidence).'}
              </p>
              <p>
                {model.dataKind === 'verified' && sourceObj ? (
                  <>
                    <a
                      href={sourceObj.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source: {sourceObj.name}
                    </a>{' '}
                    · <a href="/methodology">Full methodology</a>
                  </>
                ) : (
                  <>
                    <a href="/methodology#sample-data">
                      Source: Synapse fictional fixture catalog
                    </a>{' '}
                    · <a href="/methodology">Full methodology</a>
                  </>
                )}
              </p>
            </details>
          );
        })
      }
    </section>
    <div class="detail-stack">
      <section class="panel" id="pricing">
        <h2>API pricing</h2><ApiPricing model={model} details /><a
          class="text-link"
          href={`/cost?models=${model.slug}`}
          >Calculate your usage <ArrowRight size={15} /></a
        >
      </section><section class="panel">
        <h2>Best for</h2><div class="tags">
          {model.tags.map((tag) => <span>{tag}</span>)}
        </div><ul>{model.strengths.map((s) => <li>{s}</li>)}</ul><h3>
          Keep in mind
        </h3><ul>{model.weaknesses.map((s) => <li>{s}</li>)}</ul>
      </section><section class="panel">
        <h2>Model facts</h2><dl class="facts-list">
          <div>
            <dt>Context window</dt><dd>
              {contextSize(model.facts.context)} tokens
            </dd>
          </div><div>
            <dt>Maximum output</dt><dd>
              {contextSize(model.facts.maxOutput)} tokens
            </dd>
          </div><div>
            <dt>Speed (Throughput)</dt><dd>
              <strong>{speedLabel}</strong>{' '}
              <span class="micro muted">
                ({
                  hasOpenRouterSpeed
                    ? 'OpenRouter recent throughput'
                    : speedRating !== null
                      ? `${speedRating}/100 rating`
                      : 'No normalized rating'
                })
              </span>
            </dd>
          </div><div>
            <dt>Reasoning effort</dt><dd>
              {
                model.facts.reasoningEffort &&
                model.facts.reasoningEffort.length > 0 &&
                model.facts.reasoningEffort.some(
                  (effort) => effort !== 'none',
                ) ? (
                  <span
                    class={`effort-badge ${model.facts.reasoningEffort.includes('fixed') ? 'effort-fixed' : ''}`}
                  >
                    {model.facts.reasoningEffort.includes('fixed')
                      ? 'Fixed Reasoning CoT'
                      : `Selectable (${model.facts.reasoningEffort.join(', ')})`}
                  </span>
                ) : (
                  'Standard (Instant)'
                )
              }
            </dd>
          </div><div><dt>Family</dt><dd>{model.family}</dd></div><div>
            <dt>Status</dt><dd>
              {
                model.dataKind === 'verified'
                  ? 'Active / Production'
                  : 'Sample fixture'
              }
            </dd>
          </div>{
            (
              [
                'vision',
                'audio',
                'tools',
                'structured',
                'api',
                'openWeights',
              ] as const
            ).map((key, i) => (
              <div>
                <>
                  <dt>
                    {
                      [
                        'Vision',
                        'Audio',
                        'Tool use',
                        'Structured output',
                        'API availability',
                        'Open weights',
                      ][i]
                    }
                  </dt>
                  <dd>{model.facts[key] ? 'Yes' : 'No'}</dd>
                </>
              </div>
            ))
          }
        </dl><p class="micro">
          {
            model.dataKind === 'verified'
              ? 'Release date: '
              : 'Fixture release date: '
          }
          {model.facts.releaseDate}. Available through: {
            model.facts.availability
          }.
        </p>
      </section>
    </div>
  </div>
  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Other directions to explore</h2><p>
          Lower cost, faster answers, overall capability, and everyday use.
        </p>
      </div>
    </div><div class="model-grid">
      {alternatives.map((m) => <ModelCard model={m} />)}
    </div>
  </section>
  <section class="section panel">
    <h2>Evidence & freshness</h2><p class="section-note">
      Source updated: {model.sourceUpdatedAt}. Scores calculated: {
        model.scoreUpdatedAt
      }. Provider verification: not performed.
    </p>{
      model.sources.map((source) => (
        <p class="section-note">
          <a href={source.url}>{source.name}</a> · {source.publisher} · Fixture
          date {source.retrievedAt}
        </p>
      ))
    }<p class="section-note">
      No public benchmark results, internal test runs, or historical real-world
      scores are available for this fictional model.
    </p>
  </section>

  <script>
    function updateEffortDisplay(detail: {
      effort: string;
      stats?: {
        scores?: Record<string, number | null>;
        speedTokensPerSec?: number;
      };
      speedDisplay?: string | null;
    }) {
      if (!detail) return;
      const { effort, stats, speedDisplay } = detail;

      document
        .querySelectorAll<HTMLElement>('[data-effort-badge]')
        .forEach((el) => {
          el.textContent = `Effort: ${effort}`;
        });

      const scores = stats?.scores;
      if (scores) {
        if (scores.overall !== undefined && scores.overall !== null) {
          const overallVal = scores.overall;
          document
            .querySelectorAll<HTMLElement>('[data-effort-overall]')
            .forEach((el) => {
              el.textContent = String(overallVal);
            });
        }

        if (scores.intelligence !== undefined && scores.intelligence !== null) {
          const intelVal = scores.intelligence;
          document
            .querySelectorAll<HTMLElement>('[data-effort-intelligence]')
            .forEach((el) => {
              el.innerHTML = `${intelVal}<small>/100</small>`;
            });
        }

        for (const [metric, val] of Object.entries(scores)) {
          const scoreElem = document.querySelector<HTMLElement>(
            `#score-${metric} [data-score-value]`,
          );
          if (scoreElem && val !== null) {
            scoreElem.textContent = String(val);
          }
        }
      }

      if (speedDisplay) {
        document
          .querySelectorAll<HTMLElement>('[data-effort-speed]')
          .forEach((el) => {
            el.textContent = `${speedDisplay} tokens/sec`;
          });
      }
    }

    window.addEventListener('synapse:effort-change', ((event: CustomEvent) => {
      updateEffortDisplay(event.detail);
    }) as EventListener);
  </script>
</RootLayout>
