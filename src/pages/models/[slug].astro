---
import RootLayout from '../../layouts/RootLayout.astro';
import ModelCard from '../../components/ModelCard';
import ProviderLogo from '../../components/ProviderLogo.astro';
import { models } from '../../data/models';
import { metricLabels, overallWeights, type Metric } from '../../data/config';
import { money, contextSize, taskCost, rankModels } from '../../lib/decision';
import { ArrowRight, ChevronDown } from 'lucide-react';
export function getStaticPaths() {
  return models.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}
const { model } = Astro.props;
const alternatives = [
  ...new Map(
    [
      [...models]
        .filter((m) => m.slug !== model.slug)
        .sort((a, b) => taskCost(a) - taskCost(b))[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'speed',
      )[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'overall',
      )[0],
      rankModels(
        models.filter((m) => m.slug !== model.slug),
        'dailyUse',
      )[0],
    ].map((m) => [m.slug, m]),
  ).values(),
];
---

<RootLayout
  title={`${model.name}: scores, prices, and tradeoffs | Astra`}
  description={model.description}
>
  <div class="page-heading">
    <div class="breadcrumbs">
      <a href="/models">Models</a><span>/</span><span>{model.name}</span>
    </div><div class="detail-header">
      <div>
        <div class="provider-badge" style="margin-bottom: 8px;">
          <ProviderLogo provider={model.provider} size={20} />
          <span class="micro" style="font-weight: 600;">{model.provider}</span>
          <span class="micro"
            >· {
              model.dataKind === 'verified'
                ? 'Verified model'
                : 'Fictional sample model'
            }</span
          >
          {
            model.facts.reasoningEffort &&
              model.facts.reasoningEffort.length > 0 &&
              !model.facts.reasoningEffort.includes('none') && (
                <span
                  class={`effort-badge ${model.facts.reasoningEffort.includes('fixed') ? 'effort-fixed' : ''}`}
                  style="margin-left: 6px;"
                >
                  {model.facts.reasoningEffort.includes('fixed')
                    ? 'Fixed CoT'
                    : `Effort: ${model.facts.defaultEffort !== 'none' ? model.facts.defaultEffort : 'Selectable'}`}
                </span>
              )
          }
        </div>
        <h1>{model.name}</h1><p>{model.description}</p><div
          class="detail-actions"
        >
          <a class="button primary" href={`/compare?models=${model.slug}`}
            >Add to comparison <ArrowRight size={15} /></a
          ><a class="button" href={`/cost?models=${model.slug}`}
            >Estimate my cost</a
          >
        </div>
      </div><a class="score-number" href="#score-overall"
        >{model.scores.overall}<small>Overall / 100</small></a
      >
    </div>
  </div>
  {
    model.dataKind === 'verified' ? (
      <div class="notice">
        Verified real data tracking {model.sources.length} authoritative
        sources. Last verified: {model.lastVerifiedAt}.
      </div>
    ) : (
      <div class="notice">
        Sample data created September 5, 2026. No real model evaluations or
        provider verification are claimed.
      </div>
    )
  }
  <div class="detail-grid">
    <section class="panel" id="scores">
      <h2>Capabilities, explained.</h2><p class="micro">
        Select a score to see how it was calculated.
      </p>{
        Object.entries(metricLabels).map(([key, label]) => {
          const metric = key as Metric;
          const evidence = model.evidence.find((e) => e.metric === metric);
          const sourceObj = model.sources.find(
            (s) => s.id === evidence?.sourceId,
          );
          return (
            <details class="score-details" id={`score-${metric}`}>
              <summary>
                <>
                  <span>
                    {label}
                    <ChevronDown size={13} />
                  </span>
                  <strong>
                    {model.scores[metric]}
                    <small class="micro"> / 100</small>
                  </strong>
                </>
              </summary>
              {metric === 'overall' ? (
                <p>
                  Weighted composite:{' '}
                  {Object.entries(overallWeights)
                    .map(
                      ([k, w]) =>
                        `${metricLabels[k as Metric]} ${Math.round(w * 100)}%`,
                    )
                    .join(', ')}
                  . Rounded to the nearest integer.
                </p>
              ) : model.dataKind === 'verified' ? (
                <p>
                  Normalized score: {evidence?.normalized} / 100 derived from
                  raw measurement {evidence?.raw} on a {evidence?.min}–
                  {evidence?.max} scale. Evaluation method:{' '}
                  {evidence?.kind === 'benchmark'
                    ? 'Public benchmark dataset'
                    : 'Internal evaluation'}
                  .
                </p>
              ) : (
                <p>
                  Synthetic fixture input {evidence?.raw} on a {evidence?.min}-
                  {evidence?.max} scale. Normalization: (raw − minimum) /
                  (maximum − minimum) × 100 = {evidence?.normalized}. This input
                  is a test fixture, not a benchmark result.
                </p>
              )}
              <p>
                Methodology: {model.methodology}. Score date:{' '}
                {model.scoreUpdatedAt}. Evidence confidence: {model.confidence}%
                {model.dataKind === 'verified'
                  ? ' (source-backed confidence).'
                  : ' (no real evidence).'}
              </p>
              <p>
                {model.dataKind === 'verified' && sourceObj ? (
                  <>
                    <a
                      href={sourceObj.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source: {sourceObj.name}
                    </a>{' '}
                    · <a href="/methodology">Full methodology</a>
                  </>
                ) : (
                  <>
                    <a href="/methodology#sample-data">
                      Source: Astra fictional fixture catalog
                    </a>{' '}
                    · <a href="/methodology">Full methodology</a>
                  </>
                )}
              </p>
            </details>
          );
        })
      }
    </section>
    <div class="detail-stack">
      <section class="panel">
        <h2>API pricing</h2><div class="price-pair">
          <div>
            <strong>{money(model.pricing.input)}</strong><small
              >Input / 1M tokens</small
            >
          </div><div>
            <strong>{money(model.pricing.output)}</strong><small
              >Output / 1M tokens</small
            >
          </div>
        </div><p class="micro">
          Cached input: {money(model.pricing.cached ?? 0)} / 1M tokens. USD sample
          prices, dated {model.pricing.updatedAt}.
        </p><p class="notice">
          Typical task estimate: <strong>{money(taskCost(model), 4)}</strong><br
          />1,000 input + 500 output tokens, one attempt.
        </p><a class="text-link" href={`/cost?models=${model.slug}`}
          >Calculate your usage <ArrowRight size={15} /></a
        >
      </section><section class="panel">
        <h2>Best for</h2><div class="tags">
          {model.tags.map((tag) => <span>{tag}</span>)}
        </div><ul>{model.strengths.map((s) => <li>{s}</li>)}</ul><h3>
          Keep in mind
        </h3><ul>{model.weaknesses.map((s) => <li>{s}</li>)}</ul>
      </section><section class="panel">
        <h2>Model facts</h2><dl class="facts-list">
          <div>
            <dt>Context window</dt><dd>
              {contextSize(model.facts.context)} tokens
            </dd>
          </div><div>
            <dt>Maximum output</dt><dd>
              {contextSize(model.facts.maxOutput)} tokens
            </dd>
          </div><div>
            <dt>Reasoning effort</dt><dd>
              {
                model.facts.reasoningEffort &&
                model.facts.reasoningEffort.length > 0 &&
                !model.facts.reasoningEffort.includes('none') ? (
                  <span
                    class={`effort-badge ${model.facts.reasoningEffort.includes('fixed') ? 'effort-fixed' : ''}`}
                  >
                    {model.facts.reasoningEffort.includes('fixed')
                      ? 'Fixed Reasoning CoT'
                      : `Selectable (${model.facts.reasoningEffort.join(', ')})`}
                  </span>
                ) : (
                  'Standard (Instant)'
                )
              }
            </dd>
          </div><div><dt>Family</dt><dd>{model.family}</dd></div><div>
            <dt>Status</dt><dd>
              {
                model.dataKind === 'verified'
                  ? 'Active / Production'
                  : 'Sample fixture'
              }
            </dd>
          </div>{
            (
              [
                'vision',
                'audio',
                'tools',
                'structured',
                'api',
                'openWeights',
              ] as const
            ).map((key, i) => (
              <div>
                <>
                  <dt>
                    {
                      [
                        'Vision',
                        'Audio',
                        'Tool use',
                        'Structured output',
                        'API availability',
                        'Open weights',
                      ][i]
                    }
                  </dt>
                  <dd>{model.facts[key] ? 'Yes' : 'No'}</dd>
                </>
              </div>
            ))
          }
        </dl><p class="micro">
          {
            model.dataKind === 'verified'
              ? 'Release date: '
              : 'Fixture release date: '
          }
          {model.facts.releaseDate}. Available through: {
            model.facts.availability
          }.
        </p>
      </section>
    </div>
  </div>
  <section class="section">
    <div class="section-heading">
      <div>
        <h2>Other directions to explore</h2><p>
          Lower cost, faster answers, overall capability, and everyday use.
        </p>
      </div>
    </div><div class="model-grid">
      {alternatives.map((m) => <ModelCard model={m} />)}
    </div>
  </section>
  <section class="section panel">
    <h2>Evidence & freshness</h2><p class="section-note">
      Source updated: {model.sourceUpdatedAt}. Scores calculated: {
        model.scoreUpdatedAt
      }. Provider verification: not performed.
    </p>{
      model.sources.map((source) => (
        <p class="section-note">
          <a href={source.url}>{source.name}</a> · {source.publisher} · Fixture
          date {source.retrievedAt}
        </p>
      ))
    }<p class="section-note">
      No public benchmark results, internal test runs, or historical real-world
      scores are available for this fictional model.
    </p>
  </section>
</RootLayout>
