---
import RootLayout from '../../layouts/RootLayout.astro';
import ModelExplorer from '../../components/ModelExplorer';
import { publishedModels } from '../../data/models';
---

<RootLayout title="Explore AI models | Synapse">
  <div class="page-heading">
    <span class="eyebrow">THE MODEL EXPLORER</span>
    <h1>Meet your next AI model.</h1>
    <p>
      Explore verified models alongside clearly labeled synthetic previews.
      Compare capabilities, pricing evidence, and key tradeoffs.
    </p>
  </div>
  <ModelExplorer models={publishedModels} client:load />
</RootLayout>
