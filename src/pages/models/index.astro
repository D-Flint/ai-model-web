---
import RootLayout from '../../layouts/RootLayout.astro';
import ModelExplorer from '../../components/ModelExplorer';
import { models } from '../../data/models';
---

<RootLayout title="Explore AI models | Synapse">
  <div class="page-heading">
    <span class="eyebrow">THE MODEL EXPLORER</span>
    <h1>Meet your next AI model.</h1>
    <p>
      Models benchmarked by LiveBench. Explore verified capabilities, official pricing, and key tradeoffs.
    </p>
  </div>
  <ModelExplorer models={models} client:load />
</RootLayout>
