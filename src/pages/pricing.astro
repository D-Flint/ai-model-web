---
import RootLayout from '../layouts/RootLayout.astro';
import PricingComparison from '../components/PricingComparison';
import { publishedModels } from '../data/models';

const initialPricingAsOf = new Date().toISOString();
---

<RootLayout title="Compare API pricing | Synapse"
  ><div class="page-heading">
    <span class="eyebrow">API PRICING</span><h1>Compare model pricing</h1><p>
      Compare reviewed API pricing without guessing your monthly usage.
      Synthetic preview models remain explicitly labeled.
    </p>
  </div><PricingComparison
    models={publishedModels}
    initialPricingAsOf={initialPricingAsOf}
    client:load
  /></RootLayout
>
