---
import RootLayout from '../../layouts/RootLayout.astro';
import RankingList from '../../components/RankingList.astro';
import { categories } from '../../data/config';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const pageTitle =
  category.slug === 'speed'
    ? 'Best AI models for peak speed | Synapse'
    : `Best AI models for ${category.label.toLowerCase()} | Synapse`;
const headingText =
  category.slug === 'speed'
    ? 'Find your fit for peak generation speed.'
    : `Find your fit for ${category.label.toLowerCase()}.`;
---

<RootLayout title={pageTitle}
  ><div class="page-heading">
    <div class="breadcrumbs">
      <a href="/rankings">Rankings</a><span>/</span><span>{category.label}</span
      >
    </div><h1>{headingText}</h1><p>
      {category.description}
      Compare current production models and understand each tradeoff.
    </p>
  </div><RankingList
    metric={category.metric}
    slug={category.slug}
  /></RootLayout
>
