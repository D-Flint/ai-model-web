---
import '../styles/global.css';
import { ArrowUpRight, Moon, Sun, Menu, ArrowRight } from 'lucide-react';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Synapse | Find the right AI model',
  description = 'Find an AI model that fits your work. Explore capabilities, compare tradeoffs, and estimate costs with an explainable model guide.',
} = Astro.props;
const links = [
  ['/models', 'Models'],
  ['/compare', 'Compare'],
  ['/rankings', 'Rankings'],
  ['/find', 'Model Finder'],
  ['/cost', 'Cost Calculator'],
];
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#080B08" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('synapse-theme') ||
          localStorage.getItem('astra-theme') ||
          'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container nav-row">
        <a href="/" class="brand" aria-label="Synapse home">
          <img
            src="/synapse-mark.png"
            alt="Synapse Logo"
            class="brand-logo"
            width="30"
            height="30"
          /><span class="brand-text">SYNAPSE</span></a
        >
        <nav class="desktop-nav" aria-label="Main navigation">
          {
            links.map(([href, label]) => (
              <a
                href={href}
                aria-current={path.startsWith(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="nav-actions">
          <button
            id="theme-toggle"
            class="icon-button"
            aria-label="Toggle color theme"
            ><Moon className="moon" size={18} /><Sun
              className="sun"
              size={18}
            /></button
          ><a class="button primary nav-cta" href="/find"
            >Find my model <ArrowUpRight size={15} /></a
          ><button
            id="menu-toggle"
            class="icon-button mobile-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Open navigation"><Menu size={21} /></button
          >
        </div>
      </div><nav
        id="mobile-nav"
        class="mobile-nav container"
        hidden
        aria-label="Mobile navigation"
      >
        {links.map(([href, label]) => <a href={href}>{label}</a>)}<a
          href="/methodology">Methodology</a
        >
      </nav>
    </header>
    <div class="sample-banner">
      <span>Sample edition</span> Fictional models and illustrative data. <a
        href="/methodology#sample-data"
        >What this means <ArrowRight size={12} /></a
      >
    </div>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a href="/" class="brand" aria-label="Synapse home">
            <img
              src="/synapse-mark.png"
              alt="Synapse Logo"
              class="brand-logo brand-logo--footer"
              width="24"
              height="24"
              loading="lazy"
            /><span class="brand-text">SYNAPSE</span></a
          ><p>
            Synapse helps you compare AI models with clear, reliable data — so
            you can understand faster and choose with confidence.
          </p>
        </div><div class="footer-links">
          <a href="/models">Explore models</a><a href="/methodology"
            >Our methodology</a
          ><a href="/cost">Understand costs</a>
        </div>
      </div><div class="container footer-bottom">
        <span>© 2026 Synapse. Built for better decisions.</span><span
          >Transparent scores. Clear tradeoffs. No sponsored rankings.</span
        >
      </div>
    </footer>
    <script>
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const theme =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('synapse-theme', theme);
        } catch {
          /* Theme works without storage. */
        }
      });
      document.querySelector('#menu-toggle')?.addEventListener('click', () => {
        const nav = document.querySelector<HTMLElement>('#mobile-nav');
        const button = document.querySelector('#menu-toggle');
        if (nav) {
          nav.hidden = !nav.hidden;
          button?.setAttribute('aria-expanded', String(!nav.hidden));
          button?.setAttribute(
            'aria-label',
            nav.hidden ? 'Open navigation' : 'Close navigation',
          );
        }
      });
    </script>
  </body>
</html>
