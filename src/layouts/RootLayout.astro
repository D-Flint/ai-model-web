---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Astra - Consumer AI Model Guide & Decision Engine',
  description = 'Compare AI models on real-world intelligence, coding, agentic capabilities, and true cost per task.'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-canvas)] text-[var(--text-primary)]">
    <header class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]/80 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-8">
          <a href="/" class="flex items-center gap-2 font-semibold text-lg tracking-tight">
            <span class="w-7 h-7 rounded-md bg-[var(--accent)] text-white flex items-center justify-center font-bold text-sm">A</span>
            <span>Astra</span>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm text-[var(--text-secondary)]">
            <a href="/models" class="hover:text-[var(--text-primary)] transition-colors">Models</a>
            <a href="/compare" class="hover:text-[var(--text-primary)] transition-colors">Compare</a>
            <a href="/rankings" class="hover:text-[var(--text-primary)] transition-colors">Rankings</a>
            <a href="/find" class="hover:text-[var(--text-primary)] transition-colors">Model Finder</a>
            <a href="/cost" class="hover:text-[var(--text-primary)] transition-colors">Cost Calculator</a>
            <a href="/methodology" class="hover:text-[var(--text-primary)] transition-colors">Methodology</a>
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/compare"
            class="px-3.5 py-1.5 text-xs font-medium rounded-lg bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] transition-colors"
          >
            Compare Models
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-8 text-xs text-[var(--text-secondary)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>Astra &mdash; Transparent, consumer-first AI model decision engine.</p>
        <div class="flex items-center gap-6">
          <a href="/methodology" class="hover:underline">Methodology</a>
          <a href="/models" class="hover:underline">All Models</a>
          <a href="https://github.com/D-Flint/ai-model-web" class="hover:underline" target="_blank" rel="noopener noreferrer">Source Code</a>
        </div>
      </div>
    </footer>
  </body>
</html>
