# Database connection string (PostgreSQL)
# Required for running persistent database operations and migrations.
# Node ingestion/persistence scripts only. Workers serve prepared catalog assets.
# No database credentials are required in the deployed Worker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_model_web

# OpenRouter API Key (Optional)
# Public model catalog endpoint works without key, but can be provided to raise rate limits.
OPENROUTER_API_KEY=

# Hugging Face User Access Token (Optional)
# Can be provided if accessing gated Hugging Face datasets or raising rate limits.
HF_TOKEN=

# Production build variable: set to your actual HTTPS deployment origin.
# Export in the build environment; runtime Worker variables cannot change it.
# Leave blank locally to omit canonical URLs and sitemap locations.
SITE_URL=

# Search engines remain blocked unless this is explicitly enabled at build time.
# Requires SITE_URL so canonical, robots and sitemap URLs are absolute.
ENABLE_INDEXING=false
